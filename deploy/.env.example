# Copy to .env and adjust. Every variable has a working default for local use.
# This file drives the local all-in-one stack (deploy/docker-compose.yml). For
# production on Dokploy see deploy/dokploy/README.md; the server and compactor
# settings below apply there too.

# --- Postgres ---
POSTGRES_USER=pairpad
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pairpad
# Host port for the loopback-only Postgres binding (for local `go run`).
POSTGRES_HOST_PORT=5432

# --- Go server ---
# Compose builds the server's DATABASE_URL from the POSTGRES_* values above.
# Set this one when running the server directly on the host:
#   cd server && env $(grep -v '^#' ../deploy/.env | xargs) go run ./cmd/server
DATABASE_URL=postgres://pairpad:change-me@localhost:5432/pairpad?sslmode=disable
PORT=8080
# Comma-separated WebSocket Origin host patterns (path.Match syntax).
# Same-host origins are always accepted.
ALLOWED_ORIGINS=localhost
FLUSH_INTERVAL=500ms
FLUSH_MAX_BATCH=50
SHUTDOWN_TIMEOUT=10s
# In-memory history length at which a live room first reloads its log from
# Postgres (to pick up compaction). Doubles after each reload.
HISTORY_REFRESH_MIN=1000
# Rooms with no edits and no joins for ROOM_TTL are deleted (with their
# history) by a sweep every EXPIRY_INTERVAL. Rooms with people connected are
# never deleted.
ROOM_TTL=720h
EXPIRY_INTERVAL=1h
# People allowed in one pad at once.
MAX_PEERS=25
# Server-side backstop on a room's in-memory update log (bytes). The editor
# itself caps a pad at 512 KB of text; this only stops misbehaving clients.
MAX_HISTORY_BYTES=8388608
# New pads per client IP: up to ROOM_CREATE_BURST at once, refilled at
# ROOM_CREATE_PER_HOUR. Over the limit, POST /api/rooms returns 429.
ROOM_CREATE_BURST=10
ROOM_CREATE_PER_HOUR=60
# Comma-separated CIDRs allowed to set X-Forwarded-For (Caddy or Traefik). Empty
# means private and loopback ranges, which covers the compose network.
TRUSTED_PROXIES=
LOG_LEVEL=info

# --- Compactor ---
# How often to look for rooms to compact, and how many stored updates a room
# needs before it is merged into a snapshot. Uses DATABASE_URL and LOG_LEVEL.
COMPACT_INTERVAL=30s
COMPACT_MIN_UPDATES=500
COMPACT_ROOMS_PER_PASS=50

# --- Caddy (local stack only; Dokploy uses Traefik) ---
# Use your domain in production to get automatic HTTPS.
SITE_ADDRESS=http://localhost
