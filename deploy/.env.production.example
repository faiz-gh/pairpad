# Production environment variables for Dokploy deployment.
# Copy these into the "Environment" tab of your Dokploy Compose service.

# --- Required Networking / Routing ---
# The Traefik router rules use these to route traffic to the app.
PUBLIC_IP=203.0.113.5
TAILNET_NAME=pairpad-vps
TAILNET_FQDN=pairpad-vps.tail1234.ts.net

# --- Database ---
# The Internal Connection URL of the separate Dokploy PostgreSQL service.
DATABASE_URL=postgres://USER:PASS@postgres-service:5432/DB

# --- Server Limits & Thresholds (Optional) ---
# Uncomment and adjust if you need to override the defaults.

# LOG_LEVEL=info

# Rooms with no edits and no joins for ROOM_TTL are deleted.
# ROOM_TTL=720h
# EXPIRY_INTERVAL=1h

# MAX_PEERS=25
# MAX_HISTORY_BYTES=8388608

# Rate limits for room creation per IP
# ROOM_CREATE_BURST=10
# ROOM_CREATE_PER_HOUR=60

# HISTORY_REFRESH_MIN=1000
# FLUSH_INTERVAL=500ms
# FLUSH_MAX_BATCH=50
# SHUTDOWN_TIMEOUT=10s

# --- Compactor (Optional) ---
# COMPACT_INTERVAL=30s
# COMPACT_MIN_UPDATES=500
# COMPACT_ROOMS_PER_PASS=50

# --- Advanced ---
# Comma-separated CIDRs allowed to set X-Forwarded-For.
# TRUSTED_PROXIES=
