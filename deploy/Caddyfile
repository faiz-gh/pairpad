# Plain HTTP on localhost for development. In production set SITE_ADDRESS to
# your domain (e.g. pairpad.example.com) and Caddy provisions TLS itself.
{$SITE_ADDRESS:http://localhost} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy server:8080
	}

	handle /ws/* {
		reverse_proxy server:8080
	}

	handle {
		root * /srv

		# Hashed assets never change; the SPA shell must always revalidate.
		@immutable path /_app/immutable/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
